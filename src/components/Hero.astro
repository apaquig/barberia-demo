---
import { businessConfig } from '../config';
---

<section class="hero-section" id="hero">
  <div class="hero-bg">
    <div class="hero-overlay"></div>
  </div>
  
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-location-badge">
        <span class="dot"></span>
        {businessConfig.city.toUpperCase()}, {businessConfig.state.toUpperCase()}
      </div>
      
      <h1 class="hero-title">
        <span data-i18n="heroTitlePart1">Cortes de Precisión.</span><br/>
        <span class="text-gold" data-i18n="heroTitlePart2">Estilo Real.</span>
      </h1>
      
      <p class="hero-subheadline" data-i18n="heroLead">
        La barbería preferida de la comunidad latina en Newark. Fades modernos, perfilado de barba y cortes urbanos con la máxima precisión en New Jersey.
      </p>
      
      <div class="hero-actions">
        <a href={businessConfig.bookingUrl} class="btn-premium btn-primary" data-i18n="heroBtnBook">Reservar Turno</a>
        <a href="#services" class="btn-premium btn-outline" data-i18n="heroBtnServices">Ver Servicios</a>
      </div>
      
      <div class="hero-trust-badges">
        <div class="badge-item">
          <span class="badge-icon">⭐</span>
          <span class="badge-text" data-i18n="badge5Star">Servicio 5 Estrellas</span>
        </div>
        <div class="badge-item">
          <span class="badge-icon">✂</span>
          <span class="badge-text" data-i18n="badgeExpert">Barberos Hispanos</span>
        </div>
        <div class="badge-item">
          <span class="badge-icon">📍</span>
          <span class="badge-text" data-i18n="badgeNewark">Newark, NJ</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { translations } from './translations';
  window.addEventListener('langChanged', (e: any) => {
    const lang = e.detail.lang;
    document.querySelectorAll('#hero [data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && translations[lang][key]) {
        el.textContent = translations[lang][key];
      }
    });
  });
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
    background-color: var(--color-bg-primary);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/barberia-demo/images/hero-barber.png');
    background-size: cover;
    background-position: center right;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, 
      rgba(18,18,18,0.75) 0%, 
      rgba(18,18,18,0.6) 40%, 
      rgba(18,18,18,0.2) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    animation: fadeIn 1s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-location-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(182, 145, 82, 0.1);
    border: 1px solid rgba(182, 145, 82, 0.3);
    color: var(--color-gold);
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-family: var(--font-display);
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .hero-location-badge .dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-gold);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.1;
    font-weight: 900;
    color: var(--color-white);
    text-transform: uppercase;
  }

  .hero-subheadline {
    font-size: 1.1rem;
    color: rgba(245, 243, 237, 0.8);
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  .hero-trust-badges {
    display: flex;
    gap: 28px;
    margin-top: 36px;
    border-top: 1px solid rgba(245, 243, 237, 0.1);
    padding-top: 24px;
  }

  .badge-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .badge-icon {
    font-size: 1.1rem;
  }

  .badge-text {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(245, 243, 237, 0.7);
    font-family: var(--font-display);
    letter-spacing: 0.05em;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(182, 145, 82, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(182, 145, 82, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(182, 145, 82, 0);
    }
  }

  /* Responsive Media Queries */
  @media (max-width: 992px) {
    .hero-bg {
      background-position: center;
    }
    .hero-overlay {
      background: rgba(13, 13, 13, 0.85);
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: 80vh;
    }
    
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-subheadline {
      font-size: 1rem;
    }

    .hero-trust-badges {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
