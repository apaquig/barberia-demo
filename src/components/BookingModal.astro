---
import SocialIcons from './SocialIcons.astro';
import { translations } from './translations';
---

<div class="booking-modal-overlay" id="booking-modal">
  <div class="booking-modal-card card-glass">
    <button class="modal-close-btn" id="close-booking-modal" aria-label="Cerrar modal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <div class="modal-header">
      <h3 class="modal-title" data-i18n="modalBookTitle">Reservar Turno</h3>
      <p class="modal-subtitle" data-i18n="modalBookSubtitle">Completa los detalles para agendar tu cita en Leo Style Corp</p>
    </div>
    
    <form class="booking-form" id="booking-appointment-form">
      <div class="form-grid">
        <!-- Name -->
        <div class="form-group">
          <label for="booking-name" data-i18n="formName">Nombre Completo</label>
          <input type="text" id="booking-name" required placeholder="Ej. Juan Pérez" />
        </div>
        
        <!-- Phone -->
        <div class="form-group">
          <label for="booking-phone" data-i18n="formPhone">Número de Teléfono</label>
          <input type="tel" id="booking-phone" required placeholder="Ej. (973) 555-0199" />
        </div>

        <!-- Service Select -->
        <div class="form-group">
          <label for="booking-service" data-i18n="formService">Servicio</label>
          <select id="booking-service" required>
            <option value="" disabled selected data-i18n="formSelectService">Selecciona un servicio</option>
            <option value="Corte de Caballero" data-i18n="serviceCutsTitle">Corte de Caballero - $30</option>
            <option value="Skin Fade" data-i18n="serviceFadeTitle">Skin Fade - $35</option>
            <option value="Perfilado de Barba" data-i18n="serviceBeardTitle">Perfilado de Barba - $25</option>
            <option value="Corte + Barba" data-i18n="serviceComboTitle">Corte + Barba - $50</option>
            <option value="Marcado / Line Up" data-i18n="serviceLineupTitle">Marcado / Line Up - $15</option>
            <option value="Afeitado Toalla Caliente" data-i18n="serviceShaveTitle">Afeitado Toalla Caliente - $30</option>
          </select>
        </div>

        <!-- Barber Select -->
        <div class="form-group">
          <label for="booking-barber" data-i18n="formBarber">Barbero Preferido</label>
          <select id="booking-barber" required>
            <option value="Cualquier Barbero" data-i18n="formAnyBarber" selected>Cualquier Barbero disponible</option>
            <option value="Leo (Master Barber)">Leo (Master Barber)</option>
            <option value="Carlos (Fade Specialist)">Carlos (Fade Specialist)</option>
            <option value="Mateo (Beard Stylist)">Mateo (Beard Stylist)</option>
          </select>
        </div>

        <!-- Date -->
        <div class="form-group">
          <label for="booking-date" data-i18n="formDate">Fecha</label>
          <input type="date" id="booking-date" required />
        </div>

        <!-- Time -->
        <div class="form-group">
          <label for="booking-time" data-i18n="formTime">Hora</label>
          <select id="booking-time" required>
            <option value="" disabled selected data-i18n="formSelectTime">Selecciona la hora</option>
            <option value="09:00 AM">09:00 AM</option>
            <option value="10:00 AM">10:00 AM</option>
            <option value="11:00 AM">11:00 AM</option>
            <option value="12:00 PM">12:00 PM</option>
            <option value="01:00 PM">01:00 PM</option>
            <option value="02:00 PM">02:00 PM</option>
            <option value="03:00 PM">03:00 PM</option>
            <option value="04:00 PM">04:00 PM</option>
            <option value="05:00 PM">05:00 PM</option>
            <option value="06:00 PM">06:00 PM</option>
            <option value="07:00 PM">07:00 PM</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn-premium btn-primary btn-submit-booking" id="booking-submit-btn">
        <span data-i18n="formSubmit">Confirmar y Enviar Reserva</span>
      </button>
    </form>
  </div>
</div>

<script>
  import { translations } from './translations';

  const modal = document.getElementById('booking-modal');
  const closeBtn = document.getElementById('close-booking-modal');
  const form = document.getElementById('booking-appointment-form') as HTMLFormElement;

  // Open modal handler
  window.addEventListener('openBookingModal', (e: any) => {
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';

      // Pre-select service or barber if passed in details
      if (e.detail) {
        const serviceSelect = document.getElementById('booking-service') as HTMLSelectElement;
        const barberSelect = document.getElementById('booking-barber') as HTMLSelectElement;
        
        if (e.detail.service && serviceSelect) {
          serviceSelect.value = e.detail.service;
        }
        if (e.detail.barber && barberSelect) {
          barberSelect.value = e.detail.barber;
        }
      }
    }
  });

  // Close modal function
  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Handle language updates
  window.addEventListener('langChanged', (e: any) => {
    const lang = e.detail.lang;
    if (!modal) return;
    modal.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && translations[lang][key]) {
        el.textContent = translations[lang][key];
      }
    });
  });

  // Form submit simulated action via WhatsApp redirect
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('booking-name') as HTMLInputElement).value;
      const phone = (document.getElementById('booking-phone') as HTMLInputElement).value;
      const service = (document.getElementById('booking-service') as HTMLSelectElement).value;
      const barber = (document.getElementById('booking-barber') as HTMLSelectElement).value;
      const date = (document.getElementById('booking-date') as HTMLInputElement).value;
      const time = (document.getElementById('booking-time') as HTMLSelectElement).value;

      const message = `¡Hola Leo Style Corp! Me gustaría agendar una cita:\n\n` +
                      `👤 Nombre: ${name}\n` +
                      `📞 Teléfono: ${phone}\n` +
                      `✂ Servicio: ${service}\n` +
                      `💈 Barbero: ${barber}\n` +
                      `📅 Fecha: ${date}\n` +
                      `🕒 Hora: ${time}`;

      const whatsappUrl = `https://wa.me/19735550199?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, '_blank');
      closeModal();
      form.reset();
    });
  }
</script>

<style>
  .booking-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 20px;
  }

  .booking-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .booking-modal-card {
    position: relative;
    width: 100%;
    max-width: 600px;
    padding: 40px;
    border: 1px solid rgba(182, 145, 82, 0.2);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    border-radius: 12px;
  }

  .modal-close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: rgba(245, 243, 237, 0.6);
    cursor: pointer;
    padding: 6px;
    transition: var(--transition-smooth);
  }

  .modal-close-btn:hover {
    color: var(--color-gold);
    transform: rotate(90deg);
  }

  .modal-close-btn svg {
    width: 24px;
    height: 24px;
  }

  .modal-header {
    margin-bottom: 30px;
    text-align: center;
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--color-white);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .modal-subtitle {
    font-size: 0.9rem;
    color: rgba(245, 243, 237, 0.6);
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 576px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .booking-modal-card {
      padding: 30px 20px;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    font-weight: 600;
  }

  .form-group input, .form-group select {
    background-color: rgba(23, 23, 23, 0.95);
    border: 1px solid rgba(182, 145, 82, 0.25);
    border-radius: 6px;
    color: var(--color-white);
    padding: 12px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    outline: none;
    transition: var(--transition-smooth);
    background-clip: padding-box;
  }

  .form-group input:focus, .form-group select:focus {
    border-color: var(--color-gold);
    box-shadow: 0 0 10px rgba(182, 145, 82, 0.15);
  }

  .btn-submit-booking {
    width: 100%;
    height: 48px;
    font-size: 0.9rem;
    margin-top: 10px;
  }
</style>
